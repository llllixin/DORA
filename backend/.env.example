# Dora Backend 环境变量样例（复制为 .env 后生效）
# 注：本仓库缺省示例=template/openai；本地实测跑通的是 DeepSeek 官方，请在你的 backend/.env 置：
#   DORA_REASONING_PROVIDER=llm
#   DORA_LLM_BASE_URL=https://api.deepseek.com/v1
#   DORA_LLM_API_KEY=sk-...(不提交)
#   DORA_LLM_MODEL=deepseek-chat
DATABASE_URL=postgresql+psycopg://dora:dora@localhost:5432/dora
# V3 Reasoning provider：template（默认，无 LLM 也全绿）/ llm（T3 后可用）
DORA_REASONING_PROVIDER=template
# LLM（仅当 DORA_REASONING_PROVIDER=llm 时使用；未配 KEY 自动 fallback 到模板）
DORA_LLM_BASE_URL=https://api.openai.com/v1
# DORA_LLM_API_KEY=
DORA_LLM_MODEL=gpt-4o-mini
# LLM 刷新兜底策略（阶段 1，可选覆盖）：单条超时 / 整批预算 / 并发 / 熔断参数
DORA_LLM_TIMEOUT=10
DORA_LLM_BUDGET_SECS=20
DORA_LLM_CONCURRENCY=3
DORA_LLM_CIRCUIT_FAILS=3
DORA_LLM_CIRCUIT_WINDOW=60
DORA_LLM_CIRCUIT_COOLDOWN=30

# 普通 RAG 默认完全离线、可重复；自动门禁固定使用这两个默认值。
DORA_RAG_EMBEDDING_PROVIDER=hash
DORA_RAG_HASH_DIMENSIONS=256
# A06：更换同名模型背后的向量空间时递增；密钥/timeout变化不需要递增。
DORA_RAG_EMBEDDING_SPACE_REVISION=a06-v1
DORA_RAG_ANSWER_PROVIDER=template
# 可选真实 OpenAI provider：分别把上面两个值改为 openai，并设置密钥。
# DORA_RAG_OPENAI_API_KEY=
DORA_RAG_OPENAI_BASE_URL=https://api.openai.com/v1
DORA_RAG_EMBEDDING_MODEL=text-embedding-3-small
DORA_RAG_EMBEDDING_DIMENSIONS=512
DORA_RAG_ANSWER_MODEL=gpt-5-mini

# A04：密钥/provider选择之外，外部调用须显式启用；默认禁止。
# 每个run仍受 app/runtime/profiles.json 的累计次数/Token准入/时长限制。
DORA_MODEL_EXTERNAL_ENABLED=false
# 真实Token缺测保持unknown/null，启发式预留不是tokenizer；本阶段金额为null。
