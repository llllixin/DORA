{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DORA document: frozen legacy or governed Wiki v2",
  "type": "object",
  "required": [
    "id",
    "title",
    "knowledge_type",
    "status",
    "content",
    "source_type",
    "version",
    "valid_from",
    "reviewed_by",
    "updated_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 2
    },
    "knowledge_type": {
      "enum": [
        "glossary",
        "rule",
        "procedure",
        "case",
        "external"
      ]
    },
    "status": {
      "enum": [
        "draft",
        "reviewed",
        "retired"
      ]
    },
    "content": {
      "type": "string",
      "minLength": 20
    },
    "metric_keys": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dimensions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "concept_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_type": {
      "enum": [
        "project",
        "official",
        "simulated",
        "verified_case"
      ]
    },
    "source_ref": {
      "type": "string"
    },
    "source_url": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "valid_from": {
      "type": "string"
    },
    "valid_to": {
      "type": [
        "string",
        "null"
      ]
    },
    "reviewed_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "updated_at": {
      "type": "string"
    },
    "schema_version": {
      "const": 2
    },
    "wiki_card": {
      "type": "object",
      "required": [
        "card_type",
        "sections",
        "concept_note"
      ],
      "properties": {
        "card_type": {
          "enum": [
            "metric",
            "rule",
            "sop",
            "case"
          ]
        },
        "sections": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "concept_note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "governance": {
      "type": "object",
      "required": [
        "evidence_level",
        "applicability",
        "unknowns",
        "source_refs",
        "review"
      ],
      "properties": {
        "evidence_level": {
          "enum": [
            "project_definition",
            "simulated",
            "reported"
          ]
        },
        "applicability": {
          "type": "string",
          "minLength": 1
        },
        "unknowns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source_hashes": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "origin": {
          "type": "object"
        },
        "review": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "required": [
          "wiki_card",
          "governance"
        ]
      }
    }
  ],
  "description": "Cross-field templates, source boundaries, legacy release hashes and review payload binding are enforced by app/wiki/contracts.py."
}
